# Copier ce fichier en .env.local et y renseigner la clé.
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : modèle Claude utilisé (par défaut claude-sonnet-4-5).
# CLAUDE_MODEL=claude-sonnet-4-5

# Optionnel : taille du modèle Whisper (tiny | base | small | medium | large-v3).
# Plus c'est grand, plus c'est précis et lent. medium est un bon compromis.
# WHISPER_MODEL=medium
